      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    </apparel>
  </ThingDef>
  <ThingDef ParentName="RHA_RelicBase">
    <defName>RHA_Dragonheart</defName>
    <label>Dragonheart</label>
    <description>Grants +60% body health, +40% direct damage and 0.8 ordinary injury healing per second. Every two days worn adds +25% health, +20% damage and 0.6 healing per second, up to six growth stages. At six stages, adds 20 percentage points to execution threshold.</description>
    <graphicData>
      <texPath>RimHex/Relics/Dragonheart</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <apparel>
      <layers>
        <li>RHA_DragonLayer</li>
      </layers>
    </apparel>
    <comps>
      <li Class="RimHex.CompProperties_Prismatic">
        <power>Dragonheart</power>
        <visualStyle>Fire</visualStyle>
        <visualColor>(1.0000,0.5569,0.2902)</visualColor>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="RHA_RelicBase">
    <defName>RHA_Runecarver</defName>
    <label>Runecarver</label>
    <description>chain level +1.5; direct damage +50%; move speed +25%. Every third valid direct hit triggers chain lightning, using the global chain range setting. Copied damage uses its resolved value; flat bonus damage can still be amplified.</description>
    <graphicData>
