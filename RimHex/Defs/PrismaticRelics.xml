      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="RHA_RelicBase">
    <defName>RHA_DetonationOrb</defName>
    <label>Detonation orb</label>
    <description>detonation level +1.5; direct damage +40%. Every fourth valid direct hit detonates within 4.5 cells of the target. Copied damage uses its resolved value; flat bonus damage can still be amplified.</description>
