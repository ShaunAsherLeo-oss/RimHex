  <HediffDef>
    <defName>RHA_RuinGuard</defName>
    <label>ruin guardian</label>
    <description>Reinforced armor protects this old security machine.</description>
    <hediffClass>RimHex.Hediff_HexRuinGuard</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>
  <JobDef>
    <defName>RHA_ExploreRuin</defName>
    <driverClass>RimHex.JobDriver_HexRuin</driverClass>
    <reportString>working on TargetA.</reportString>
  </JobDef>
